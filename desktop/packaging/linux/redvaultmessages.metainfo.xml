<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<!-- AppStream description of the desktop app. App Center, GNOME Software and KDE Discover
     read it; the snap (packaging/linux/make-snap.sh) takes its version notes from here.
     Check with: appstreamcli validate redvaultmessages.metainfo.xml -->
<component type="desktop-application">
  <id>com.redvaultsystems.redvaultmessages</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <name>RedVaultMessages</name>
  <summary>End-to-end encrypted messenger</summary>
  <developer id="com.redvaultsystems">
    <name>RedVault Systems</name>
  </developer>

  <description>
    <p>
      Private messages, calls, files and a password vault, encrypted on your own
      devices and reached through Tor.
    </p>
    <ul>
      <li>One-to-one and group chats</li>
      <li>Voice and video calls</li>
      <li>Encrypted file storage and a password vault</li>
    </ul>
  </description>

  <launchable type="desktop-id">redvaultmessages.desktop</launchable>
  <icon type="stock">redvaultmessages</icon>

  <url type="homepage">https://www.redvaultsystems.com/</url>
  <url type="vcs-browser">https://github.com/cybermarkagency/redvault-messages</url>

  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
  </categories>
  <keywords>
    <keyword>messenger</keyword>
    <keyword>chat</keyword>
    <keyword>encrypted</keyword>
    <keyword>Tor</keyword>
    <keyword>calls</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>

  <releases>
    <release version="0.8.0" date="2026-11-14">
      <description>
        <p>Ready for per-device encryption keys in chats, channels and communities, and
        for Stories protected by those keys. Each turns on once RedVault switches it on
        for your account.</p>
      </description>
    </release>
    <release version="0.7.3" date="2026-11-14">
      <description>
        <p>A backup route: when Tor can't reach the onion service, the app still
        connects through Tor, to the website, with every request sealed so that
        only our server can read it. You can turn it off in Settings.</p>
      </description>
    </release>
    <release version="0.7.2" date="2026-11-14">
      <description>
        <p>A cleaner layout: the side bar runs the full height of the window, and
        Privacy and Stories have left the side bar and Settings.</p>
      </description>
    </release>
  </releases>
</component>
