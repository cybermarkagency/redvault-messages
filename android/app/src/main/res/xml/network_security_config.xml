<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only (user-installed CAs can't MITM the app). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Tor by default (docs/tor-by-default.md): http:// to the service's own onion address only. The onion
         service itself authenticates the server (the address is its key) and encrypts end to end, and the app
         reaches it only through the embedded Tor gateway, never directly. A release build checks that this is
         its API base's host (checkTorOnlyRelease in app/build.gradle.kts). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">4cydjhdc3lmhg7l6ykjont7dms2alunglmnlznlmjjwkyc67m5h325yd.onion</domain>
    </domain-config>
</network-security-config>
